# Пример настроек Chimera. Скопируйте в .env и задайте свои значения.
# Файл .env не коммитится: в нём ключи шифрования персональных данных.

# --- Режим работы -----------------------------------------------------------------
# server        — сервер (PostgreSQL, несколько пользователей, за nginx/HTTPS);
# desktop-local — локальный режим Windows-клиента (SQLite, ключи создаются сами).
CHIMERA_MODE=server

# --- База данных ------------------------------------------------------------------
# PostgreSQL 16: postgresql+psycopg://пользователь:пароль@хост:5432/база
# Пусто — SQLite в CHIMERA_DATA_DIR/chimera.db (для разработки и desktop-режима).
DATABASE_URL=
# Только для deploy/docker-compose.yml: параметры контейнера PostgreSQL.
POSTGRES_DB=chimera
POSTGRES_USER=chimera
POSTGRES_PASSWORD=replace-with-strong-db-password

# --- Секреты ----------------------------------------------------------------------
# Ключ подписи сессий, не короче 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Ключ шифрования полей с персональными данными (Fernet). ПОТЕРЯ КЛЮЧА = ПОТЕРЯ ДАННЫХ.
# Храните копию ключа отдельно от резервных копий базы.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Для ротации: НОВЫЙ_КЛЮЧ,СТАРЫЙ_КЛЮЧ (новые значения шифруются первым).
DATA_ENCRYPTION_KEY=
# Необязательно: отдельный ключ слепого индекса (поиск по СНИЛС, паспорту).
# Если не задан — выводится из первого ключа DATA_ENCRYPTION_KEY.
BLIND_INDEX_KEY=

# --- Начальная настройка ----------------------------------------------------------
# При первом запуске создаются организация и системный администратор.
# Пароль нужно сменить при первом входе; после этого переменную можно удалить.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=
CHIMERA_DEFAULT_ORG_NAME=Моя образовательная организация
# university — вуз, college — колледж (СУЗ): определяет терминологию интерфейса.
CHIMERA_DEFAULT_ORG_TYPE=college

# --- Каталоги ---------------------------------------------------------------------
# Данные приложения (SQLite, загрузки, бэкапы). Относительные пути — от корня проекта.
CHIMERA_DATA_DIR=instance
# CHIMERA_UPLOAD_DIR=instance/uploads
# CHIMERA_BACKUP_DIR=instance/backups
MAX_UPLOAD_SIZE_MB=16

# --- Резервные копии --------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
# Путь к pg_dump той же основной версии, что и сервер PostgreSQL.
PG_DUMP_PATH=pg_dump

# --- Безопасность -----------------------------------------------------------------
# true при работе через HTTPS (по умолчанию true в режиме server).
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600
# Включайте только когда сайт доступен исключительно по HTTPS.
ENABLE_HSTS=false

# --- Сервер разработки (python -m chimera run) ------------------------------------
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false

# --- gunicorn (контейнер и systemd) -----------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
